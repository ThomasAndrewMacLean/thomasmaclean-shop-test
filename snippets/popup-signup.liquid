{% doc %}
  @param {string} [client_id] - Customer Account API OAuth client ID. When provided, first name and last name are silently updated on the customer profile after login. Register the pages where this popup appears as Redirect URIs in your Customer Account API app settings.
  @example
  {% render 'popup-signup' %}
  {% render 'popup-signup', client_id: 'your-client-id-here' %}
{% enddoc %}

<div class="popup-signup" data-popup-signup
  {% if client_id != blank %}data-client-id="{{ client_id }}"{% endif %}
  {% if customer %}data-customer-id="{{ customer.id }}"{% endif %}
  data-shop-domain="{{ shop.permanent_domain }}">
  <button
    type="button"
    class="popup-signup__trigger button button-primary"
    data-popup-signup-open
    aria-haspopup="dialog"
  >
    Become a customer
  </button>

  <dialog
    class="popup-signup__dialog"
    data-popup-signup-dialog
    aria-label="Customer signup"
  >
    <div class="popup-signup__panel">
      <button
        type="button"
        class="popup-signup__close"
        data-popup-signup-close
        aria-label="Close signup dialog"
      >
        &times;
      </button>

      <h2 class="popup-signup__heading">Create your customer account</h2>
      <p class="popup-signup__subheading">Submit your details to start your new Shopify account signup.</p>

      <form class="popup-signup__form" data-popup-signup-form>

        <label class="popup-signup__field">
          <span class="popup-signup__label">First name</span>
          <input
            class="popup-signup__input"
            type="text"
            name="first_name"
            autocomplete="given-name"
            required
          >
        </label>

        <label class="popup-signup__field">
          <span class="popup-signup__label">Family name</span>
          <input
            class="popup-signup__input"
            type="text"
            name="last_name"
            autocomplete="family-name"
            required
          >
        </label>

        <label class="popup-signup__field">
          <span class="popup-signup__label">Birthday</span>
          <input
            class="popup-signup__input"
            type="date"
            name="birthday"
            autocomplete="bday"
            required
          >
        </label>

        <label class="popup-signup__field">
          <span class="popup-signup__label">Email</span>
          <input
            class="popup-signup__input"
            type="email"
            name="email"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            required
          >
        </label>

        <button type="submit" class="popup-signup__submit button button-primary">Sign up</button>

        <p class="popup-signup__message popup-signup__message--success" data-popup-signup-success hidden>
          Thanks! Continue to complete account setup.
          <a href="{{ routes.storefront_login_url }}" data-popup-signup-continue>Continue</a>
        </p>
      </form>
    </div>
  </dialog>
</div>

<style>
  .popup-signup {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 50;
  }

  .popup-signup__trigger {
    border-radius: 999px;
    box-shadow: 0 8px 30px rgb(0 0 0 / 20%);
  }

  .popup-signup__dialog {
    width: min(94vw, 480px);
    border: 0;
    border-radius: 1rem;
    padding: 0;
    background: transparent;
  }

  .popup-signup__dialog::backdrop {
    background: rgb(0 0 0 / 45%);
  }

  .popup-signup__panel {
    position: relative;
    padding: 1.5rem;
    border-radius: 1rem;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #111);
  }

  .popup-signup__close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .popup-signup__heading {
    margin: 0 2rem 0.4rem 0;
  }

  .popup-signup__subheading {
    margin: 0 0 1rem;
    opacity: 0.8;
  }

  .popup-signup__form {
    display: grid;
    gap: 0.8rem;
  }

  .popup-signup__field {
    display: grid;
    gap: 0.35rem;
  }

  .popup-signup__label {
    font-size: 0.9rem;
  }

  .popup-signup__input {
    width: 100%;
    min-height: 2.75rem;
    border: 1px solid rgb(0 0 0 / 18%);
    border-radius: 0.5rem;
    padding: 0.65rem 0.75rem;
    background: transparent;
    color: inherit;
  }

  .popup-signup__submit {
    justify-self: start;
    margin-top: 0.35rem;
  }

  .popup-signup__consent {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .popup-signup__consent input {
    margin-top: 0.15rem;
  }

  .popup-signup__message {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
  }

  .popup-signup__message--error {
    color: #b42318;
  }

  .popup-signup__message--success {
    color: #067647;
  }

  @media screen and (max-width: 749px) {
    .popup-signup {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
    }

    .popup-signup__trigger {
      width: 100%;
    }
  }
</style>

<script>
  (() => {
    function safeStorage(action, key, value) {
      try {
        if (action === 'get') return sessionStorage.getItem(key);
        if (action === 'set') sessionStorage.setItem(key, value);
        if (action === 'del') sessionStorage.removeItem(key);
      } catch (_e) {}
      return null;
    }

    async function generateVerifier() {
      const buf = new Uint8Array(32);
      crypto.getRandomValues(buf);
      return btoa(String.fromCharCode(...buf)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
    }

    async function generateChallenge(verifier) {
      const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(verifier));
      return btoa(String.fromCharCode(...new Uint8Array(digest))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
    }

    function generateState() {
      return Date.now().toString(36) + Math.random().toString(36).slice(2);
    }

    async function initiateAuth(shopDomain, clientId) {
      const config = await (await fetch(`https://${shopDomain}/.well-known/openid-configuration`)).json();
      const verifier = await generateVerifier();
      const challenge = await generateChallenge(verifier);
      const state = generateState();
      const redirectUri = window.location.origin + window.location.pathname;

      safeStorage('set', 'popup-signup-verifier', verifier);
      safeStorage('set', 'popup-signup-state', state);
      safeStorage('set', 'popup-signup-token-endpoint', config.token_endpoint);
      safeStorage('set', 'popup-signup-redirect-uri', redirectUri);

      const url = new URL(config.authorization_endpoint);
      url.searchParams.set('client_id', clientId);
      url.searchParams.set('response_type', 'code');
      url.searchParams.set('redirect_uri', redirectUri);
      url.searchParams.set('scope', 'openid email customer-account-api:full');
      url.searchParams.set('state', state);
      url.searchParams.set('code_challenge', challenge);
      url.searchParams.set('code_challenge_method', 'S256');
      url.searchParams.set('prompt', 'none');
      window.location.assign(url.toString());
    }

    async function enrichCustomer(shopDomain, clientId, code) {
      const verifier = safeStorage('get', 'popup-signup-verifier');
      const tokenEndpoint = safeStorage('get', 'popup-signup-token-endpoint');
      const redirectUri = safeStorage('get', 'popup-signup-redirect-uri');
      const pendingJson = safeStorage('get', 'popup-signup-pending');
      if (!verifier || !tokenEndpoint || !pendingJson) return;

      const pending = JSON.parse(pendingJson);

      const tokenResp = await fetch(tokenEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({
          grant_type: 'authorization_code',
          client_id: clientId,
          code,
          redirect_uri: redirectUri,
          code_verifier: verifier,
        }),
      });
      const tokenData = await tokenResp.json();
      if (!tokenData.access_token) return;

      const apiConfig = await (await fetch(`https://${shopDomain}/.well-known/customer-account-api`)).json();

      await fetch(apiConfig.graphql_api, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: tokenData.access_token },
        body: JSON.stringify({
          query: `mutation customerUpdate($input: CustomerUpdateInput!) {
            customerUpdate(input: $input) { customer { id } userErrors { field message } }
          }`,
          variables: { input: { firstName: pending.firstName, lastName: pending.lastName } },
        }),
      });

      ['popup-signup-pending', 'popup-signup-verifier', 'popup-signup-state',
       'popup-signup-token-endpoint', 'popup-signup-redirect-uri'].forEach((k) => safeStorage('del', k));

      const cleanUrl = new URL(window.location.href);
      cleanUrl.searchParams.delete('code');
      cleanUrl.searchParams.delete('state');
      window.history.replaceState({}, '', cleanUrl.toString());
    }

    const roots = document.querySelectorAll('[data-popup-signup]');

    roots.forEach((root) => {
      if (root.dataset.popupSignupReady === 'true') {
        return;
      }
      root.dataset.popupSignupReady = 'true';

      const clientId = root.dataset.clientId;
      const customerId = root.dataset.customerId;
      const shopDomain = root.dataset.shopDomain;
      const dialog = root.querySelector('[data-popup-signup-dialog]');
      const openButton = root.querySelector('[data-popup-signup-open]');
      const closeButton = root.querySelector('[data-popup-signup-close]');
      const form = root.querySelector('[data-popup-signup-form]');
      const successMessage = root.querySelector('[data-popup-signup-success]');
      const continueLink = root.querySelector('[data-popup-signup-continue]');

      if (!dialog || !openButton || !closeButton || !form) {
        return;
      }

      const urlParams = new URLSearchParams(window.location.search);
      const code = urlParams.get('code');
      const returnedState = urlParams.get('state');
      const savedState = safeStorage('get', 'popup-signup-state');
      const isCallback = code && returnedState && returnedState === savedState && clientId && shopDomain;

      if (isCallback) {
        enrichCustomer(shopDomain, clientId, code).catch(() => {});
      }

      const openDialog = () => {
        if (typeof dialog.showModal === 'function') {
          try { dialog.showModal(); return; } catch (_e) {}
        }
        dialog.setAttribute('open', 'open');
      };

      const closeDialog = () => {
        if (typeof dialog.close === 'function') { dialog.close(); return; }
        dialog.removeAttribute('open');
      };

      openButton.addEventListener('click', () => {
        if (successMessage) successMessage.hidden = true;
        openDialog();
      });

      closeButton.addEventListener('click', () => closeDialog());

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closeDialog();
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();

        const firstNameInput = form.querySelector('input[name="first_name"]');
        const lastNameInput = form.querySelector('input[name="last_name"]');
        const birthdayInput = form.querySelector('input[name="birthday"]');
        const emailInput = form.querySelector('input[name="email"]');
        const emailValue = emailInput && emailInput.value ? emailInput.value.trim() : '';

        if (clientId) {
          safeStorage('set', 'popup-signup-pending', JSON.stringify({
            firstName: firstNameInput ? firstNameInput.value.trim() : '',
            lastName: lastNameInput ? lastNameInput.value.trim() : '',
            birthday: birthdayInput ? birthdayInput.value : '',
          }));
        }

        if (!emailValue || !continueLink) return;

        const loginUrl = new URL(continueLink.getAttribute('href'), window.location.origin);
        const returnPath = `${window.location.pathname}${window.location.search}${window.location.hash}`;
        loginUrl.searchParams.set('return_to', returnPath);
        loginUrl.searchParams.set('login_hint', emailValue);
        continueLink.setAttribute('href', loginUrl.toString());

        if (successMessage) successMessage.hidden = false;
      });

      if (!isCallback && clientId && customerId && shopDomain && safeStorage('get', 'popup-signup-pending')) {
        initiateAuth(shopDomain, clientId).catch(() => {});
      }
    });
  })();
</script>
