          <p class="order-list__item-price">
            {% if line.final_line_price > 0 %}
              {{ line.final_line_price | money }}
                {% if line.unit_price_measurement %}
    <div class="order-list__unit-price">
      {%- liquid
        assign price = line.unit_price | money
        assign count = line.unit_price_measurement.reference_value
        assign unit = line.unit_price_measurement.reference_unit
        case line.unit_price_measurement.reference_unit
          when 'mg'
            assign unit = 'mg'
          when 'g'
            assign unit = 'g'
          when 'kg'
            assign unit = 'kg'
          when 'ml'
            assign unit = 'ml'
          when 'cl'
            assign unit = 'cl'
          when 'l'
            assign unit = 'l'
          when 'm3'
            assign unit = 'm³'
          when 'mm'
            assign unit = 'mm'
          when 'cm'
            assign unit = 'cm'
          when 'm'
            assign unit = 'm'
          when 'm2'
            assign unit = 'm²'
          when 'oz'
            assign unit = 'oz'
          when 'lb'
            assign unit = 'lb'
          when 'floz'
            assign unit = 'fl oz'
          when 'pt'
            assign unit = 'pt'
          when 'qt'
            assign unit = 'qt'
          when 'gal'
            assign unit = 'gal'
          when 'in'
            assign unit = 'in'
          when 'ft'
            assign unit = 'ft'
          when 'yd'
            assign unit = 'yd'
          when 'ft2'
            assign unit = 'ft²'
          when 'item'
            assign unit = 'artikel'
        endcase
        if unit == 'item'
          if count == 1
            echo price | append: ' per stuk'
          else
            echo price | append: ' per ' | append: count | append: ' artikelen'
          endif
        else
          if count == 1
            echo price | append: '/' | append: unit
          else
            echo price | append: '/' | append: count | append: unit
          endif
        endif
      -%}
    </div>
  {% endif %}

            {% else %}
